CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_CODEC_ES8389_SUPPORT=y
CONFIG_UAC_SAMPLE_RATE=48000
CONFIG_UAC_MIC_CHANNEL_NUM=1
CONFIG_UAC_SPEAKER_CHANNEL_NUM=0
CONFIG_UAC_BIT_RESOLUTION_16=y
CONFIG_UAC_MIC_INTERVAL_MS=10
CONFIG_UAC_TINYUSB_TASK_PRIORITY=6
CONFIG_UAC_MIC_TASK_PRIORITY=5
CONFIG_UAC_TUSB_PRODUCT="BOX2 Microphone"
CONFIG_UAC_TUSB_MANUFACTURER="BOX2"

# On-device wake word. esp-sr needs a dedicated "model" partition, which is why
# the project switched off the 1 MB SINGLE_APP table. Models are read from flash
# (mmap) instead of being copied into RAM; NS/VAD stay on the cheap WebRTC
# implementations because the deep models cost PSRAM and CPU we need for USB.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_MODEL_IN_FLASH=y
CONFIG_SR_WN_WN10_HILEXIN_INT16=y
CONFIG_SR_NSN_WEBRTC=y
CONFIG_SR_VADN_WEBRTC=y
